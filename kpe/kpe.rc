#include <windows.h>
#include "resource.h"

1 RT_MANIFEST "kpe.manifest"

IDR_MENU MENU
BEGIN
	POPUP "&File"
	BEGIN
		MENUITEM "&New...\tCtrl+N", IDM_NEW
		MENUITEM "&Open...\tCtrl+O", IDM_OPEN
		MENUITEM "&Save\tCtrl+S", IDM_SAVE
		MENUITEM "Save &As...", IDM_SAVEAS
		MENUITEM SEPARATOR
		MENUITEM "&Export WAV...", IDM_EXPORTWAV
		MENUITEM SEPARATOR
		MENUITEM "E&xit", IDM_EXIT
	END
	POPUP "&Edit"
	BEGIN
		MENUITEM "&Undo\tCtrl+Z", IDM_UNDO
		MENUITEM "&Redo\tCtrl+Y", IDM_REDO
		MENUITEM SEPARATOR
		MENUITEM "Cu&t frames\tCtrl+X", IDM_CUT
		MENUITEM "&Copy frames\tCtrl+C", IDM_COPY
		MENUITEM "&Paste frames\tCtrl+V", IDM_PASTE
		MENUITEM "&Delete frames\tDel", IDM_DELETE
		MENUITEM "&Insert frames...\tIns", IDM_INSERT
		MENUITEM SEPARATOR
		MENUITEM "Select &all\tCtrl+A", IDM_SELECTALL
	END
	POPUP "&Synthesis"
	BEGIN
		MENUITEM "&Synthesize\tF5", IDM_SYNTH
	END
	POPUP "S&ound"
	BEGIN
		MENUITEM "&Play / stop\tSpace", IDM_PLAY
		MENUITEM "Play &selection\tShift+Space", IDM_PLAYSEL
	END
	POPUP "&Parameters"
	BEGIN
		MENUITEM "&Globals...", IDM_GLOBALS
		MENUITEM "&Optimize...", IDM_OPTIMIZE
	END
	POPUP "&View"
	BEGIN
		MENUITEM "&Frame table\tCtrl+T", IDM_TABLE
		MENUITEM "&Narrowband spectrogram", IDM_NARROW
		MENUITEM "Frequency &range...", IDM_FREQRANGE
		MENUITEM SEPARATOR
		MENUITEM "Zoom &in\tCtrl++", IDM_ZOOMIN
		MENUITEM "Zoom &out\tCtrl+-", IDM_ZOOMOUT
		MENUITEM "Zoom to &fit\tCtrl+0", IDM_ZOOMFIT
	END
	POPUP "&Help"
	BEGIN
		MENUITEM "&Parameter reference", IDM_PARAMREF
		MENUITEM "&About", IDM_ABOUT
	END
END

IDR_ACCEL ACCELERATORS
BEGIN
	"N", IDM_NEW, VIRTKEY, CONTROL
	"O", IDM_OPEN, VIRTKEY, CONTROL
	"S", IDM_SAVE, VIRTKEY, CONTROL
	"Z", IDM_UNDO, VIRTKEY, CONTROL
	"Y", IDM_REDO, VIRTKEY, CONTROL
	"X", IDM_CUT, VIRTKEY, CONTROL
	"C", IDM_COPY, VIRTKEY, CONTROL
	"V", IDM_PASTE, VIRTKEY, CONTROL
	"A", IDM_SELECTALL, VIRTKEY, CONTROL
	"T", IDM_TABLE, VIRTKEY, CONTROL
	VK_DELETE, IDM_DELETE, VIRTKEY
	VK_INSERT, IDM_INSERT, VIRTKEY
	VK_F5, IDM_SYNTH, VIRTKEY
	VK_SPACE, IDM_PLAY, VIRTKEY
	VK_SPACE, IDM_PLAYSEL, VIRTKEY, SHIFT
	VK_OEM_PLUS, IDM_ZOOMIN, VIRTKEY, CONTROL
	VK_ADD, IDM_ZOOMIN, VIRTKEY, CONTROL
	VK_OEM_MINUS, IDM_ZOOMOUT, VIRTKEY, CONTROL
	VK_SUBTRACT, IDM_ZOOMOUT, VIRTKEY, CONTROL
	"0", IDM_ZOOMFIT, VIRTKEY, CONTROL
END

IDD_GLOBALS DIALOGEX 0, 0, 330, 200
STYLE DS_MODALFRAME | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Globals"
FONT 9, "Segoe UI"
BEGIN
	LTEXT "Duration (ms):", IDC_DURATION_LBL, 7, 9, 60, 8
	EDITTEXT IDC_DURATION, 70, 7, 50, 12, ES_AUTOHSCROLL
	LTEXT "", IDC_FIELDS, 7, 26, 316, 126, NOT WS_VISIBLE
	LTEXT "", IDC_NOTE, 7, 158, 316, 16
	DEFPUSHBUTTON "OK", IDOK, 219, 180, 50, 14
	PUSHBUTTON "Cancel", IDCANCEL, 273, 180, 50, 14
END

IDD_OPTIMIZE DIALOGEX 0, 0, 340, 250
STYLE DS_MODALFRAME | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Optimize"
FONT 9, "Segoe UI"
BEGIN
	LTEXT "Tracks:", -1, 7, 7, 60, 8
	CONTROL "", IDC_TRACKS, "SysListView32", LVS_REPORT | LVS_NOCOLUMNHEADER | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP, 7, 18, 90, 200
	GROUPBOX "Range", -1, 105, 7, 110, 44
	AUTORADIOBUTTON "Selection", IDC_RANGE_SEL, 112, 19, 90, 10, WS_GROUP
	AUTORADIOBUTTON "Whole file", IDC_RANGE_ALL, 112, 33, 90, 10
	LTEXT "Breakpoint grid:", -1, 105, 60, 60, 8
	COMBOBOX IDC_GRID, 168, 58, 60, 60, CBS_DROPDOWNLIST | WS_TABSTOP
	GROUPBOX "Tolerance", -1, 105, 76, 110, 62
	LTEXT "Formants, bandwidths (Hz):", -1, 111, 89, 70, 16
	EDITTEXT IDC_TOL_HZ, 180, 88, 30, 12
	LTEXT "F0 (Hz):", -1, 111, 105, 60, 8
	EDITTEXT IDC_TOL_F0, 180, 104, 30, 12
	LTEXT "Amplitudes (dB):", -1, 111, 121, 60, 8
	EDITTEXT IDC_TOL_DB, 180, 120, 30, 12
	PUSHBUTTON "Preview", IDC_PREVIEW, 105, 146, 50, 14
	EDITTEXT IDC_SUMMARY, 222, 7, 111, 211, ES_MULTILINE | ES_READONLY | WS_VSCROLL
	DEFPUSHBUTTON "Apply", IDOK, 229, 229, 50, 14
	PUSHBUTTON "Cancel", IDCANCEL, 283, 229, 50, 14
END

IDD_PARAMREF DIALOGEX 0, 0, 420, 260
STYLE DS_MODALFRAME | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Parameter reference"
FONT 9, "Segoe UI"
BEGIN
	CONTROL "", IDC_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP, 7, 7, 406, 226
	DEFPUSHBUTTON "Close", IDOK, 363, 239, 50, 14
END

IDD_ASKNUM DIALOGEX 0, 0, 200, 60
STYLE DS_MODALFRAME | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 9, "Segoe UI"
BEGIN
	LTEXT "", IDC_ASK_LABEL, 7, 9, 110, 8
	EDITTEXT IDC_ASK_VALUE, 120, 7, 73, 12, ES_AUTOHSCROLL
	DEFPUSHBUTTON "OK", IDOK, 89, 39, 50, 14
	PUSHBUTTON "Cancel", IDCANCEL, 143, 39, 50, 14
END
